{
  // 보통은 탐색기에서 OM_Translator.pyw 더블클릭으로 실행합니다. (F5 는 개발/확인용)
  "version": "0.2.0",
  "configurations": [
    {
      "name": "OM 번역기 (프로그램 창)",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/gui.py"
    },
    {
      "name": "설치 점검 (--check)",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/main.py", "args": ["--check"]
    },
    {
      "name": "콘솔로 input\\pdf 한 번 처리 (--once)",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/main.py", "args": ["--once"]
    }
  ]
}
