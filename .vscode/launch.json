{
  // F5 로 실행. 보통은 run.bat 더블클릭만 사용하면 됩니다.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Plant O&M Translator (input\\pdf 일괄 + 감시)",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/main.py"
    },
    {
      "name": "한 번만 처리 (--once)",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/main.py", "args": ["--once"]
    },
    {
      "name": "샘플 1-5페이지 (--pages 1-5 --force)",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/main.py", "args": ["--pages", "1-5", "--force"]
    },
    {
      "name": "레이아웃 테스트 (--mock, API 없음)",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/main.py", "args": ["--mock", "--once", "--force"]
    },
    {
      "name": "분량/토큰 추정 (--estimate)",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/main.py", "args": ["--estimate"]
    },
    {
      "name": "설치 점검 (--check)",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/main.py", "args": ["--check"]
    }
  ]
}
