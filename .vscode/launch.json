{
  // F5(실행 및 디버그)에서 선택해서 실행합니다. 보통은 맨 위 "OM 번역기 (GUI)"만 쓰면 됩니다.
  "version": "0.2.0",
  "inputs": [
    { "id": "pdf", "type": "promptString", "description": "원본 PDF 파일 또는 폴더 경로", "default": "OM_EN" },
    { "id": "page", "type": "promptString", "description": "OCR 확인할 페이지 번호", "default": "1" }
  ],
  "configurations": [
    {
      "name": "OM 번역기 (GUI)",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/om_gui.py"
    },
    {
      "name": "분량 추정 + 페이지 진단",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/om_translate.py",
      "args": ["estimate", "${input:pdf}", "--glossary", "glossary.csv"]
    },
    {
      "name": "OCR 결과 확인 (한 페이지)",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/om_ocr.py",
      "args": ["${input:pdf}", "--page", "${input:page}", "--debug"]
    },
    {
      "name": "Copilot 프롬프트 만들기 (export)",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/om_translate.py",
      "args": ["export", "${input:pdf}", "-o", "OM_KO", "--glossary", "glossary.csv", "--keep-patterns", "keep_patterns.txt"]
    },
    {
      "name": "Copilot 답변 반영 (import)",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/om_translate.py",
      "args": ["import", "-o", "OM_KO", "--glossary", "glossary.csv", "--keep-patterns", "keep_patterns.txt"]
    },
    {
      "name": "한국어 PDF 만들기 (translate)",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/om_translate.py",
      "args": ["translate", "${input:pdf}", "-o", "OM_KO", "--glossary", "glossary.csv", "--keep-patterns", "keep_patterns.txt", "--force"]
    }
  ]
}
